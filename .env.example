# ============================================================================
#  KMSIT COMPUTER · Frontend (Vite)
#  Salin menjadi `.env.production` lalu isi URL backend Laravel Anda.
#  Hanya variabel berawalan VITE_ yang dikirim ke browser.
# ============================================================================

# URL backend Laravel (REST API + MySQL). Kosongkan untuk mode lokal tertanam.
# Contoh lokal : http://localhost:8000
# Contoh server: https://api.domainanda.com
VITE_API_URL=

# Nama aplikasi (opsional — default diambil dari settings database)
VITE_APP_NAME="KMSIT Computer"
