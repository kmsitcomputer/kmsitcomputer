# ============================================================================
#  KMSIT COMPUTER · Backend Laravel (.env)
#  Salin file ini menjadi `.env` lalu isi nilai sebenarnya.
#  SATU-SATUNYA database yang didukung: MySQL. Jangan ganti DB_CONNECTION.
# ============================================================================

APP_NAME="KMSIT Computer"
APP_ENV=production
APP_KEY=                          # isi dengan: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.domainanda.com
FRONTEND_URL=https://domainanda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------- DATABASE (WAJIB MySQL) ---------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kmsit_computer
DB_USERNAME=root
DB_PASSWORD=
# Import struktur tabel via phpMyAdmin: file public/database/kmsit_computer.sql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.domainanda.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kmsit_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------- MAIL ---------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.domainanda.com
MAIL_PORT=587
MAIL_USERNAME=halo@domainanda.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=halo@domainanda.com
MAIL_FROM_NAME="${APP_NAME}"

# --------------------- SANCTUM (Auth API React ↔ Laravel) -------------------
SANCTUM_STATEFUL_DOMAINS=domainanda.com,localhost:3000,localhost:5173

# --------------------------- PAYMENT GATEWAY --------------------------------
# Hanya untuk pembayaran kelas berbayar (BUKAN donasi — fitur donasi tidak ada).
# Credential development/sandbox dan production dipisahkan oleh *_MODE.
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_SECRET_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_WEBHOOK_URL="${APP_URL}/api/payments/webhook/tripay"

XENDIT_MODE=sandbox
XENDIT_API_KEY=
XENDIT_WEBHOOK_URL="${APP_URL}/api/payments/webhook/xendit"

STRIPE_MODE=sandbox
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_URL="${APP_URL}/api/payments/webhook/stripe"

# ------------------------------ INTEGRASI -----------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# ------------------------------ STORAGE -------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
